{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LDT",
  "scopeName": "source.ldt",
  "patterns": [
    {
      "match": "^(\\d{3})(8000|8001)(.*)$",
      "captures": {
        "1": {
          "name": "variable.ldt"
        },
        "2": {
          "name": "keyword.ldt"
        },
        "3": {
          "name": "constant.character.escape.ldt"
        }
      }
    },
    {
      "match": "^(\\d{3})(8002|8003)(.*)$",
      "captures": {
        "1": {
          "name": "variable.ldt"
        },
        "2": {
          "name": "keyword.other.object.ldt"
        },
        "3": {
          "name": "entity.name.class.ldt"
        }
      }
    },
    {
      "match": "^(\\d{3})(8[12]\\d\\d)(.*)$",
      "captures": {
        "1": {
          "name": "variable.ldt"
        },
        "2": {
          "name": "keyword.other.attribute.ldt"
        },
        "3": {
          "name": "entity.name.type.ldt"
        }
      }
    },
    {
      "match": "^(\\d{3})(3\\d{3})(.*)$",
      "captures": {
        "1": {
          "name": "variable.ldt"
        },
        "2": {
          "name": "keyword.control.ldt"
        },
        "3": {
          "name": "string.ldt"
        }
      }
    },
    {
      "match": "^(\\d{3})(3564|6220|6221|6227|6228|7423|8460)(.*)$",
      "captures": {
        "1": {
          "name": "variable.ldt"
        },
        "2": {
          "name": "keyword.ldt"
        },
        "3": {
          "name": "comment.ldt"
        }
      }
    },
    {
      "match": "^(\\d{3})(6329)(.*)$",
      "captures": {
        "1": {
          "name": "variable.ldt"
        },
        "2": {
          "name": "keyword.ldt"
        },
        "3": {
          "name": "comment.block.base64.ldt"
        }
      }
    },
    {
      "match": "^(\\d{3})(\\d{4})(.*)$",
      "captures": {
        "1": {
          "name": "variable.ldt"
        },
        "2": {
          "name": "keyword.ldt"
        },
        "3": {
          "name": "string.ldt"
        }
      }
    },
    {
      "match": "^.+$",
      "name": "invalid.illegal.ldt"
    }
  ]
}
