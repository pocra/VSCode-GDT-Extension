{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "KVDT",
  "scopeName": "source.kvdt",
  "patterns": [
    {
      "match": "^(\\d{3})(8000|8001)(.*)$",
      "captures": {
        "1": {
          "name": "variable.kvdt"
        },
        "2": {
          "name": "keyword.kvdt"
        },
        "3": {
          "name": "constant.character.escape.kvdt"
        }
      }
    },
    {
      "match": "^(\\d{3})(8002|8003)(.*)$",
      "captures": {
        "1": {
          "name": "variable.kvdt"
        },
        "2": {
          "name": "keyword.other.object.kvdt"
        },
        "3": {
          "name": "entity.name.class.kvdt"
        }
      }
    },
    {
      "match": "^(\\d{3})(3\\d{3})(.*)$",
      "captures": {
        "1": {
          "name": "variable.kvdt"
        },
        "2": {
          "name": "keyword.control.kvdt"
        },
        "3": {
          "name": "string.kvdt"
        }
      }
    },
    {
      "match": "^(\\d{3})(3564|6220|6221|6227|6228|7423|8460)(.*)$",
      "captures": {
        "1": {
          "name": "variable.kvdt"
        },
        "2": {
          "name": "keyword.kvdt"
        },
        "3": {
          "name": "comment.kvdt"
        }
      }
    },
    {
      "match": "^(\\d{3})(6329)(.*)$",
      "captures": {
        "1": {
          "name": "variable.kvdt"
        },
        "2": {
          "name": "keyword.kvdt"
        },
        "3": {
          "name": "comment.block.base64.kvdt"
        }
      }
    },
    {
      "match": "^(\\d{3})(\\d{4})(.*)$",
      "captures": {
        "1": {
          "name": "variable.kvdt"
        },
        "2": {
          "name": "keyword.kvdt"
        },
        "3": {
          "name": "string.kvdt"
        }
      }
    },
    {
      "match": "^.+$",
      "name": "invalid.illegal.kvdt"
    }
  ]
}
