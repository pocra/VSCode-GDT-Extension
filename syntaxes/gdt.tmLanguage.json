{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GDT",
  "scopeName": "source.gdt",
  "patterns": [
    {
      "match": "^(\\d{3})(8000|8001)(.*)$",
      "captures": {
        "1": {
          "name": "variable.gdt"
        },
        "2": {
          "name": "keyword.gdt"
        },
        "3": {
          "name": "constant.character.escape.gdt"
        }
      }
    },
    {
      "match": "^(\\d{3})(8002|8003)(.*)$",
      "captures": {
        "1": {
          "name": "variable.gdt"
        },
        "2": {
          "name": "keyword.other.object.gdt"
        },
        "3": {
          "name": "entity.name.class.gdt"
        }
      }
    },
    {
      "match": "^(\\d{3})(8[12]\\d\\d)(.*)$",
      "captures": {
        "1": {
          "name": "variable.gdt"
        },
        "2": {
          "name": "keyword.other.attribute.gdt"
        },
        "3": {
          "name": "entity.name.type.gdt"
        }
      }
    },
    {
      "match": "^(\\d{3})(3\\d{3})(.*)$",
      "captures": {
        "1": {
          "name": "variable.gdt"
        },
        "2": {
          "name": "keyword.control.gdt"
        },
        "3": {
          "name": "string.gdt"
        }
      }
    },
    {
      "match": "^(\\d{3})(3564|6220|6221|6227|6228|7423|8460)(.*)$",
      "captures": {
        "1": {
          "name": "variable.gdt"
        },
        "2": {
          "name": "keyword.gdt"
        },
        "3": {
          "name": "comment.gdt"
        }
      }
    },
    {
      "match": "^(\\d{3})(6329)(.*)$",
      "captures": {
        "1": {
          "name": "variable.gdt"
        },
        "2": {
          "name": "keyword.gdt"
        },
        "3": {
          "name": "comment.block.base64.gdt"
        }
      }
    },
    {
      "match": "^(\\d{3})(\\d{4})(.*)$",
      "captures": {
        "1": {
          "name": "variable.gdt"
        },
        "2": {
          "name": "keyword.gdt"
        },
        "3": {
          "name": "string.gdt"
        }
      }
    },
    {
      "match": "^.+$",
      "name": "invalid.illegal.gdt"
    }
  ]
}
